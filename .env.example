# Server-only database connection. Use a restricted pooled runtime login.
DATABASE_URL=
# Direct administrator connection for migrations only; never put this in Vercel runtime.
DATABASE_URL_UNPOOLED=
APP_ORIGIN=http://localhost:3000

# Server-only PayPal Sandbox app credentials.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_MERCHANT_ID=your_sandbox_seller_merchant_id
PAYPAL_WEBHOOK_ID=
# Optional public client identifier for SDK-based integrations. The redirect UI does not use it.
# A client ID is public; never expose PAYPAL_CLIENT_SECRET or an access token.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id

# Vercel deployments can use AI Gateway OIDC; local AI tests need a gateway key.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-6.1-sol
